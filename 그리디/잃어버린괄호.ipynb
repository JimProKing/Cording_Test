    "## 괄호는 맘대로 추가 가능. 어쨋든 최소가 되도록 만들기\n",
    "\n",
    "answer = 0\n",
    "A = list(map(str, input().split(\"-\")))\n",
    "B = []\n",
    "for i in A:\n",
    "    temp = eval(i)\n",
    "    B.append(temp)\n",
    "Base = B[0]\n",
    "for i in range(1,len(B)):\n",
    "    Base -= B[i]\n",
    "print(Base)"
